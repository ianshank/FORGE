# FORGE environment variables
# Copy this file to .env and update values for your environment.
# Lines starting with # are comments and are ignored.

# ── Service ports ──────────────────────────────────────────────────────────
# Host port for the demo UI (default: 8080)
DEMO_UI_PORT=8080

# Host port for the FORGE Env REST API (default: 8765)
API_PORT=8765

# ── REST API session pool ──────────────────────────────────────────────────
# Maximum number of concurrent environment sessions
FORGE_MAX_SESSIONS=64

# Session TTL in seconds (sessions inactive longer than this are evicted)
FORGE_SESSION_TTL=3600

# Allowed CORS origins for the REST API (comma-separated or *)
FORGE_CORS_ORIGINS=*

# ── W&B / MLflow (optional — only needed for logging-hooks extras) ─────────
# WANDB_MODE=disabled
# MLFLOW_TRACKING_URI=http://localhost:5000
