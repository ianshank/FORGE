# EditorConfig — cross-editor baseline for FORGE.
# Complements (does not replace) rustfmt, biome, ruff, and .markdownlint.json;
# this only sets the whitespace/encoding basics every editor should honour.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust — rustfmt default is 4-space; keep in sync.
[*.rs]
indent_size = 4
max_line_length = 100

# JS/TS (mc-bot, dashboard, demo_ui frontend) — Biome uses 2-space.
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# Python — ruff line-length is 100 (see pyproject.toml).
[*.py]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Preserve hard line breaks in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
