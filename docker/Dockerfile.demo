# FORGE Demo — Lightweight container for the demo UI only.

FROM python:3.11-slim-bookworm
WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx

COPY demo_ui/ /app/demo_ui/
COPY forge.toml /app/

ENV PYTHONPATH=/app:$PYTHONPATH

EXPOSE 8000
CMD ["uvicorn", "demo_ui.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
