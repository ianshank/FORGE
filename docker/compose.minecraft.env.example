# Example environment file for docker/compose.minecraft.yml.
#
# Copy to `docker/compose.minecraft.env` and adjust. The compose file
# reads every value below as `${VAR:-default}`, so you can leave any
# line unset to take the default — with ONE exception:
# `GRAFANA_ADMIN_PASSWORD` has no default and MUST be set (see below).

# --- Network exposure -------------------------------------------------
# Host interface every published port binds to. Docker's default (no host
# IP) is 0.0.0.0, which reaches past most host firewalls because Docker
# writes its own iptables rules. Nothing in this stack authenticates —
# the mc-bot WebSocket and the prismarine viewer are wide open, the
# Minecraft server runs with MC_ONLINE_MODE=FALSE, and Prometheus'
# query API exposes every scraped series. So: loopback by default.
#
# Opt in explicitly if you need remote access (including remote Minecraft
# clients joining MC_SERVER_PORT, which loopback prevents):
#   BIND_HOST=0.0.0.0        # all interfaces
#   BIND_HOST=192.168.1.20   # one specific interface
BIND_HOST=127.0.0.1

# --- Minecraft server -------------------------------------------------
MC_SERVER_IMAGE=itzg/minecraft-server:latest
MC_VERSION=1.20.4
MC_TYPE=VANILLA
MC_MEMORY=2G
MC_ONLINE_MODE=FALSE
MC_DIFFICULTY=easy
MC_GAMEMODE=survival
MC_VIEW_DISTANCE=10
MC_MAX_PLAYERS=4
MC_SERVER_PORT=25565
MC_SERVER_DATA_DIR=./minecraft-server-data
MC_RESTART_POLICY=unless-stopped

# IMPORTANT: read https://www.minecraft.net/en-us/eula and accept by
# setting MC_EULA=TRUE here. We do NOT default to TRUE.
MC_EULA=FALSE

# --- mc-bot bridge ----------------------------------------------------
# NOTE: the mc-bot reads its WS bind address from
# `configs/minecraft/env.toml` (mounted into the container), so the
# only knob in the env file that affects the actual listener is the
# port. The values below are consumed by `docker compose` and forwarded
# to the container as env vars.
MC_BOT_IMAGE=forge-mc-bot:dev
MC_BOT_WS_PORT=8765
MC_BOT_VIEWER_PORT=3007
MC_BOT_TARGET_HOST=minecraft
MC_BOT_TARGET_PORT=25565
MC_BOT_USERNAME=forge_bot
MC_BOT_AUTH=offline
MC_BOT_RESTART_POLICY=on-failure
MC_CONFIG_DIR=../configs/minecraft

# --- forge-mc-runner --------------------------------------------------
FORGE_MC_RUNNER_IMAGE=forge-mc-runner:dev
# Overrides `configs/minecraft/runner.toml`'s `episodes`. Left unset so the
# TOML value (the v0.5 baseline target) applies; set it for a short smoke
# run. An explicit `--episodes` flag still beats this.
# RUNNER_EPISODES=10
#
# Trained identity (env-var ladder, not a second TOML):
#   RUNNER_RANDOM_ACTIONS=false
#   RUNNER_FEATURES=mc-live-bundled
# `mc_self_play.sh` exports both unless `--baseline-only`. Empty
# RUNNER_RANDOM_ACTIONS leaves the shipped runner.toml at
# random_actions=true. Rebuild the runner image after changing FEATURES.
# RUNNER_RANDOM_ACTIONS=
# RUNNER_FEATURES=mc-live
RUST_LOG=forge_mc_runner=info,forge_env_mc=info,forge_agent=info
MODELS_DIR=../models
TRAJECTORIES_DIR=../trajectories
RUNNER_RESTART_POLICY=on-failure

# Optional env-var override of the runner's `schema_id`. When set,
# the runner uses this value instead of the one in `runner.toml`.
# `mc_self_play.sh` populates it from `compute-schema-id --quiet`.
# FORGE_MC_SCHEMA_ID=

# --- v0.4 trainer service (profile=self-play) -------------------------
# These knobs are only consumed when invoking compose with
# `--profile self-play` (default `mc_run.sh` callers ignore them).
TRAINER_IMAGE=forge-mc-trainer:dev
TRAINER_TORCH_VARIANT=cpu   # `cpu` or `cu121` (CUDA 12.1)
TRAINER_DEVICE=cpu          # `cpu`, `cuda`, or `auto`
TRAINER_ROUND_ITERS=10
TRAINER_POLL_SLEEP=5
TRAINER_MAX_TRAJECTORIES=200
TRAINER_MAX_BUNDLE_VERSIONS=5
TRAINER_EXPORT_EVERY=10
TRAINER_OBS_DIM=920          # v0.5 Phase 1: 11×11×1×7 grid + 73 flat = 920
                             # (set to 31 if env.toml has include_block_grid=false)
TRAINER_ACTION_DIM=12        # default action count from action_map.toml
TRAINER_RESTART_POLICY=on-failure

# --- GPU overlay (compose.minecraft.gpu.yml) --------------------------
# Only consumed when invoking compose with the GPU overlay file:
#   docker compose -f compose.minecraft.yml -f compose.minecraft.gpu.yml ...
# OR via `scripts/mc_self_play.sh --gpu`.
TRAINER_GPU_COUNT=1
TRAINER_GPU_DEVICES=all      # `all` or comma-separated GPU UUIDs

# --- Resource limits (deploy.resources) -------------------------------
# Per-service CPU (cores) and memory limits + reservations. Enforced by
# `docker compose up` on Compose v2+. Defaults are conservative; raise them
# for production hosts. `cpus` is fractional cores; memory accepts the usual
# suffixes (M/G).
MC_CPU_LIMIT=2.0
MC_MEM_LIMIT=3G
MC_CPU_RESERVATION=0.5
MC_MEM_RESERVATION=1G
MC_BOT_CPU_LIMIT=1.0
MC_BOT_MEM_LIMIT=1G
MC_BOT_CPU_RESERVATION=0.25
MC_BOT_MEM_RESERVATION=256M
RUNNER_CPU_LIMIT=2.0
RUNNER_MEM_LIMIT=2G
RUNNER_CPU_RESERVATION=0.5
RUNNER_MEM_RESERVATION=512M
TRAINER_CPU_LIMIT=4.0
TRAINER_MEM_LIMIT=8G
TRAINER_CPU_RESERVATION=1.0
TRAINER_MEM_RESERVATION=2G

# --- Structured logging ----------------------------------------------
# Shared switch across Rust/Python/Node: `text` (default) or `json`.
FORGE_LOG_FORMAT=text

# --- Monitoring profile (profile=monitoring) --------------------------
# Only consumed with `--profile monitoring`. Prometheus scrapes the runner's
# /metrics over the compose network.
#
# LOW-2: for Prometheus to reach the runner, set `metrics_bind = "0.0.0.0"` in
# configs/minecraft/runner.toml. That bind is CONTAINER-INTERNAL ONLY — the
# runner's metrics port is not published to the host by this compose file.
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_PORT=9091         # host port -> prometheus:9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_CPU_LIMIT=1.0
PROMETHEUS_MEM_LIMIT=1G
PROMETHEUS_CPU_RESERVATION=0.25
PROMETHEUS_MEM_RESERVATION=256M
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3001            # host port -> grafana:3000
GRAFANA_ADMIN_USER=admin
# REQUIRED — no default. The compose file uses `${GRAFANA_ADMIN_PASSWORD:?...}`,
# so leaving this empty makes `docker compose` refuse to run rather than
# publishing Grafana with admin/admin (which is what it used to do).
#
# Compose interpolates the whole file regardless of active profiles, so this
# must be set even when you are not running `--profile monitoring`. Pick a
# real value, e.g. `openssl rand -base64 24`:
GRAFANA_ADMIN_PASSWORD=
GRAFANA_CPU_LIMIT=1.0
GRAFANA_MEM_LIMIT=512M
GRAFANA_CPU_RESERVATION=0.25
GRAFANA_MEM_RESERVATION=128M
MONITORING_DIR=./monitoring
MONITORING_RESTART_POLICY=unless-stopped
