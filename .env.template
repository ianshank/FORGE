# FORGE GCP Integration Environment Variables
# Copy to .env and fill in values for your deployment.
#
# These map to the shared `hrmtrain` GCP project infrastructure.
# See also: Civ6-AlphaZero .env.template for the sibling project.

# ======================== Cloud Storage Backend ========================
# Set to "gcs" to use Google Cloud Storage; "local" for filesystem.
FORGE_CLOUD_STORAGE_BACKEND=gcs

# GCS bucket (shared with Civ6-AlphaZero; FORGE uses the forge/ prefix)
FORGE_CLOUD_GCS_BUCKET=civ6az-training
FORGE_CLOUD_GCS_PREFIX=forge/

# GCP project and region
FORGE_CLOUD_GCP_PROJECT=hrmtrain
FORGE_CLOUD_GCP_REGION=us-central1

# Service account (empty = use Application Default Credentials)
# The existing SA already has storage.objectAdmin on the bucket.
FORGE_CLOUD_GCP_SERVICE_ACCOUNT=civ6az-vertex@hrmtrain.iam.gserviceaccount.com

# ======================== Cloud Paths (within GCS prefix) ========================
FORGE_CLOUD_REPLAY_ARCHIVE_PATH=replays
FORGE_CLOUD_MODEL_REGISTRY_PATH=models
FORGE_CLOUD_CHECKPOINT_PATH=checkpoints

# ======================== Edge Model Pulls ========================
FORGE_EDGE_GCS_MODEL_BUCKET=civ6az-training
FORGE_EDGE_GCS_MODEL_PREFIX=forge/models/

# ======================== GCP Authentication ========================
# Point to your service account key file for local development.
# In production (GCE/GKE/Cloud Run), ADC is automatic.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/hrmtrain-sa-key.json
