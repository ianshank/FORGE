# LM Studio teacher pipeline outputs (tracked under artifacts/, but
# documented explicitly so contributors don't accidentally check them in
# from a custom output_root):
#   - artifacts/teacher_traces/<scenario_id>/ep<NNNNNN>-<NNNN>.jsonl[.gz]
#   - artifacts/mangomas/<run_name>/stages/bc/bc_weights.npz
forge_teacher_traces/
teacher_traces/

# Copilot memory workspace state
/memories/

# ML Models and ONNX Exports
*.onnx
models/
*.pt
*.pth

# dhat profiler side-effect file (forge-bench allocation_audit)
dhat-heap.json

# CI-generated allocation-audit artefacts at the repo root
# (the tracked baselines live under benchmarks/baselines/<profile>/, which
# this rule is anchored to NOT match thanks to the leading slash).
/alloc_audit.json
/alloc_audit_summary.json

# Criterion benchmark output produced by `cargo bench -p forge-bench`
# (the tracked baselines under benchmarks/baselines/<profile>/ are unaffected).
target/criterion-baseline/

# Tarpaulin coverage XML produced locally by the `coverage` CI job
cobertura.xml
tarpaulin-report.html
tarpaulin-report.json

# Playwright artefacts (demo_ui/tests/test_e2e_browser.py)
playwright-report/
.playwright/

# Minecraft integration runtime artefacts
# - replays/minecraft/  : TrajectoryV2 JSONL files written by forge-mc-runner
# - trajectories/       : default forge-mc-runner output dir (RunnerConfig::Default)
# - models/             : ONNX weights + manifest reloaded between episodes
#                         (also caught by the existing *.onnx + models/ rules
#                         above, kept here for discoverability when grepping
#                         for "minecraft" in .gitignore)
replays/minecraft/
replay_buffer/minecraft/
trajectories/
# Atomic-save .tmp siblings — should never persist past a successful write
# but pin in .gitignore so a crashed save during dev doesn't get committed.
**/.*.json.tmp
**/.model_manifest.json.tmp
# mc-bot npm install output (covered by node_modules/ above, pinned for grep)
mc-bot/node_modules/
# mc-bot iteration debris — NEVER commit screenshots from a private MC world
mc-bot/screenshots/
mc-bot/.logs/

# Per-validation toolchain pin + per-gate triage logs emitted by the
# post-merge validation harness (see docs/architecture.md §3.9 and the
# Phase E aggregation in the validation plan).
.test-env.txt
.test-env.json
summary-pr*.md

