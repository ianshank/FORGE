e2e_results.json
demo_results.md
artifacts/
runs/
wandb/
mlruns/

# LM Studio teacher pipeline outputs (tracked under artifacts/, but
# documented explicitly so contributors don't accidentally check them in
# from a custom output_root):
#   - artifacts/teacher_traces/<scenario_id>/ep<NNNNNN>-<NNNN>.jsonl[.gz]
#   - artifacts/mangomas/<run_name>/stages/bc/bc_weights.npz
forge_teacher_traces/
teacher_traces/

# Copilot memory workspace state
/memories/

# ML Models and ONNX Exports
*.onnx
models/
# The Python package `python/forge/models/` is source (MuZeroConfig),
# not ONNX exports. `models/` above would otherwise hide new files
# there from `git add` of the directory.
!python/forge/models/
!python/forge/models/*.py
*.pt
*.pth

# dhat profiler side-effect file (forge-bench allocation_audit)
dhat-heap.json

# CI-generated allocation-audit artefacts at the repo root
# (the tracked baselines live under benchmarks/baselines/<profile>/, which
# this rule is anchored to NOT match thanks to the leading slash).
/alloc_audit.json
/alloc_audit_summary.json

# Criterion benchmark output produced by `cargo bench -p forge-bench`
# (the tracked baselines under benchmarks/baselines/<profile>/ are unaffected).
target/criterion-baseline/

# Tarpaulin coverage XML produced locally by the `coverage` CI job
cobertura.xml
tarpaulin-report.html
tarpaulin-report.json

# wasm-pack output for the GitHub Pages demo (built in CI from crates/forge-wasm)
web/pkg/

# Playwright artefacts (demo_ui/tests/test_e2e_browser.py + dashboard/e2e)
playwright-report/
.playwright/
blob-report/

# Minecraft integration runtime artefacts
# - replays/minecraft/  : TrajectoryV2 JSONL files written by forge-mc-runner
# - trajectories/       : default forge-mc-runner output dir (RunnerConfig::Default)
# - models/             : ONNX weights + manifest reloaded between episodes
#                         (also caught by the existing *.onnx + models/ rules
#                         above, kept here for discoverability when grepping
#                         for "minecraft" in .gitignore)
replays/minecraft/
replay_buffer/minecraft/
trajectories/
# v0.5 Phase 1: per-variant trajectory dirs (see
# python/forge/training/muzero_mc/capture_baseline.py::resolve_trajectory_dir).
# Operator-side workspace; never tracked.
trajectories.random/
trajectories.trained/
_smoke_traj/
# Local baseline-capture outputs: `capture-baseline` / `mc_plot_baseline` /
# `v05_manual_baseline` write `baseline_<variant>.json` at the repo root. The
# committed report snapshots live under `docs/results/` and are unaffected by
# this root-anchored rule.
/baseline_*.json
# Gzip-compressed sibling of the .json trajectory output. Now opt-in
# via RunnerConfig.trajectory_compression = "gzip" (v0.3-pre); same
# .gitignore policy as plain .json — never tracked.
**/trajectories/*.json.gz
**/replays/minecraft/*.json.gz
# muzero_mc trainer working directory: ONNX bundles + manifest. The
# trainer writes one bundle every `export_every_n_iters`; lives under
# the user-chosen --out path. Tracked the .example surface, NEVER
# the live exports.
muzero_mc_runs/
training_runs/minecraft/
# v0.4 atomic versioned bundle subdirs emitted by
# `MuzeroMcTrainer._export_bundle` (T4a). Layout:
#   models/
#   ├── model_manifest.json
#   └── v00000001/
#       ├── representation.onnx
#       ├── dynamics.onnx
#       └── prediction.onnx
# Already covered by the existing `models/` rule above, pinned here
# for discoverability when grepping the .gitignore for v0.4 churn.
models/v*/
**/models/v*/
# Compose-stack operator state (Phase 6).
# - docker/compose.minecraft.env  : operator-edited env file (NEVER commit;
#                                   may contain MC_EULA acceptance or
#                                   tokens). The .example sibling is
#                                   tracked.
# - minecraft-server-data/        : default compose volume for the
#                                   itzg/minecraft-server world data
docker/compose.minecraft.env
minecraft-server-data/
# forge-server persistent history: append-only JSONL files (training metrics +
# decision traces) written at runtime under FORGE_SERVER_HISTORY_DIR
# (default `forge-history/`). Operator/runtime state — never tracked.
forge-history/
**/forge-history/
# Atomic-save .tmp siblings — should never persist past a successful write
# but pin in .gitignore so a crashed save during dev doesn't get committed.
**/.*.json.tmp
**/.model_manifest.json.tmp
**/.tmp-*.manifest
# Tarpaulin / coverage CI side-effects within the runner crate
crates/forge-mc-runner/cobertura.xml
# mc-bot npm install output (covered by node_modules/ above, pinned for grep)
mc-bot/node_modules/
# mc-bot iteration debris — NEVER commit screenshots from a private MC world
mc-bot/screenshots/
mc-bot/.logs/
# TypeScript build artefacts. v0.3-pre adds the typecheck gate
# (`tsc --noEmit`); the v0.4 `.js → .ts` rewrite emits to dist/ +
# tsbuildinfo. Both excluded so a local `npm run build` doesn't
# leak into commits.
mc-bot/dist/
mc-bot/.tsbuildinfo
mc-bot/**/*.d.ts.map

# Per-validation toolchain pin + per-gate triage logs emitted by the
# post-merge validation harness (see docs/architecture.md §3.9 and the
# Phase E aggregation in the validation plan).
.test-env.txt
.test-env.json
summary-pr*.md

# Nested duplicate clone directory
/FORGE/

# Scratch and temporary scripts
scratch_recipe.js
mc-bot/scratch_bot.js

# cargo-mutants working output (mutants.out/, and the previous run it
# rotates to mutants.out.old/). Regenerated by `make mutants`.
mutants.out/
mutants.out.old/

# Allocation audit artifacts from `make alloc-audit`
alloc_audit.json
alloc_audit_summary.json
coverage.xml
.coverage
htmlcov/

# DeerFlow sandboxed artifacts
scratch.tmp/
