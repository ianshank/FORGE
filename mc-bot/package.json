{
  "name": "forge-mc-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Node bot bridging mineflayer to forge-env-mc over WebSocket. JSON-only protocol v1.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx --test test/*.test.ts",
    "test:no-deps": "tsx --test test/protocol.test.ts test/action_map.test.ts test/reward.test.ts test/schema_id.test.ts test/config.test.ts test/actions.test.ts test/observation.test.ts test/observation_grid.test.ts test/index.test.ts test/bot_manager.test.ts",
    "test:coverage": "c8 --check-coverage --lines 85 --branches 75 --functions 90 --reporter=text --reporter=json-summary --reporter=html npm test",
    "start": "tsx src/index.ts",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mineflayer": "^4.20.0",
    "mineflayer-pvp": "^1.3.2",
    "prismarine-recipe": "^1.5.0",
    "prismarine-viewer": "^1.30.0",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26",
    "@types/ws": "^8.5.10",
    "c8": "^12.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  }
}
